{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*"]
}
