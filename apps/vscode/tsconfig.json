{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
