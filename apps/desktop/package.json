{
  "name": "codeshelf-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "CodeShelf — Developer-focused snippet knowledge system desktop application",
  "author": {
    "name": "CodeShelf Team",
    "email": "support@codeshelf.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sagarkrjha/codeshelf.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --external:electron --external:@google/genai && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --external:@google/genai",
    "build:web": "pnpm --filter codeshelf-web build",
    "copy:web": "node ./scripts/copyWebDist.js",
    "build": "pnpm run build:web && pnpm run copy:web && pnpm run build:electron",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build:electron && electron . --dev",
    "typecheck": "tsc --noEmit",
    "desktop:dist": "pnpm run build && electron-builder --publish never",
    "desktop:dist:win": "pnpm run build && electron-builder --win --publish never",
    "desktop:dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "desktop:dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "desktop:dir": "pnpm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.codeshelf.desktop",
    "productName": "CodeShelf",
    "electronVersion": "44.4.5",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "CodeShelf Team <support@codeshelf.dev>"
    },
    "publish": {
      "provider": "github",
      "owner": "sagarkrjha",
      "repo": "codeshelf"
    }
  },
  "dependencies": {
    "@codeshelf/shared": "workspace:*",
    "codeshelf-web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "44.4.5",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  }
}
